# Copy this file to `.env` (or `.env.local`) for local overrides.
# All variables must be prefixed with `VITE_` to be exposed to the client.

# Base path for asset URLs.
# - Use '/' for user/org GitHub Pages sites (https://you.github.io)
# - Use '/<repo>' for project pages (https://you.github.io/<repo>/)
# - Use './' for local file:// or self-hosted subdirectories
# VITE_BASE_PATH=./

# Default in `.github/workflows/deploy.yml` is '/clay' — change it there if your repo name differs.

# Optional: Custom NVIDIA NIM base URL for production deployments.
# NIM only allows CORS from build.nvidia.com. To use Clay from GitHub Pages,
# Netlify, Vercel, or any other origin, deploy an edge proxy (Cloudflare Worker,
# Vercel function, Netlify function) that forwards /v1/* to NIM with CORS headers,
# then set this to your proxy URL (e.g., https://my-proxy.example.com/v1).
# VITE_NIM_BASE_URL=https://my-proxy.example.com/v1

# Optional: Extra origins to add to CSP connect-src directive.
# Comma-separated list of origins (e.g., https://custom1.example.com,https://custom2.example.com).
# Use if your edge proxy is on a different domain than VITE_NIM_BASE_URL.
# VITE_CSP_EXTRA_CONNECT_SRC=https://extra-origin.example.com
