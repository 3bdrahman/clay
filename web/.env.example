# Copy this file to `.env` (or `.env.local`) for build-time overrides.
# `VITE_`-prefixed variables are additionally exposed to the client bundle;
# the build-only variables below are read by vite.config.ts via process.env
# (a `VITE_BASE_PATH` would NOT be read — the build reads `BASE_PATH`).

# Build-only: Vite `base` for asset URLs.
# - Set automatically to /<repo-name>/ when DEPLOY_TARGET=github-pages
# - Use '/<repo>' for project pages hosted on other static hosts
# - './' (default) serves root-hosted deployments
# BASE_PATH=./

# Build-only: marks a GitHub Pages deployment (Vite `base` becomes /<repo-name>/)
# DEPLOY_TARGET=github-pages

# Client-exposed: injects the deploy origin into the CSP `connect-src`
# VITE_DEPLOY_URL=https://you.github.io/<repo>

# Client-exposed: appends extra origins to the CSP `connect-src`
# (comma-separated, e.g. https://custom1.example.com,https://custom2.example.com)
# Use for edge proxies on a different domain than the deploy origin.
# VITE_CSP_EXTRA_CONNECT_SRC=https://extra-origin.example.com

# Client-exposed: overrides the OpenRouter `Referer` fallback
# (defaults to the GitHub Pages origin)
# VITE_OPENROUTER_REFERER=https://you.github.io/<repo>

# Client-exposed: edge proxy for DuckDuckGo web search in production.
# DuckDuckGo sends no CORS headers, so browser deployments cannot reach it
# directly; in dev the Vite server proxies it. Point this at an edge proxy
# or use a Serper API key in Settings.
# VITE_WEBSEARCH_BASE_URL=https://my-proxy.example.com
