{
  "name": "clay-web",
  "private": true,
  "version": "0.1.0",
  "description": "Clay — browser-based RAG assistant (web app)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc -b --noEmit",
    "lint": "oxlint src --deny-warnings",
    "lint:fix": "oxlint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "vitest run src/eval/eval.test.ts",
    "verify": "npm run type-check && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "arquero": "^8.0.3",
    "autoprefixer": "^10.5.4",
    "dompurify": "^3.4.15",
    "marked": "^18.0.7",
    "pdfjs-dist": "^6.3.289",
    "postcss": "^8.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.1"
  }
}
